# Optional. Defaults to .agentmesh/state.json in the current working directory.
AGENTMESH_DATA_DIR=.agentmesh

# Optional project identity used by the local MVP.
AGENTMESH_PROJECT_ID=default
AGENTMESH_PROJECT_NAME=AgentMesh Project


# Optional. Set to 1 to fsync each state write before atomic replacement.
# This improves power-loss durability at the cost of latency.
AGENTMESH_DURABLE_WRITES=0